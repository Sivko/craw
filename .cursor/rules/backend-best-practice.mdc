### Модули

```
backend/src/
├── auth/              # Авторизация
│   ├── auth.controller.ts
│   ├── auth.service.ts
│   ├── auth.module.ts
│   └── dto/
│       ├── login.dto.ts
│       └── register.dto.ts
├── rooms/             # Комнаты
│   ├── rooms.controller.ts
│   ├── rooms.service.ts
│   ├── rooms.repository.ts
│   ├── rooms.module.ts
│   └── dto/
